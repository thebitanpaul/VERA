# Copy to .env and fill in as needed. VERA reads .env automatically; real
# environment variables always win, so a platform secret is never shadowed.
#
# Nothing here is required: with no keys set, VERA runs the deterministic mock
# backend and writes escalations to var/escalations/.

# =============================================================================
# LLM backend
# =============================================================================
# auto  -> first configured of: gemini, anthropic, openai, xai; else mock
VERA_BACKEND=auto

# --- Google Gemini (free tier works) -----------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# IMPORTANT: leave GEMINI_MODEL unset unless you know the model is served on
# your plan. 'gemini-flash-latest' is a rolling alias that always points at a
# current free-tier flash model.
#
# Do NOT use gemini-2.0-flash / gemini-2.5-flash / gemini-1.5-*: their free-tier
# quota is now 0, so every call returns 429 "limit: 0" — which reads like an
# exhausted key but is really a retired model. VERA rejects these ids up front.
# GEMINI_MODEL=gemini-flash-latest

# --- OpenAI (GPT) -------------------------------------------------------------
# Key from https://platform.openai.com/api-keys. Requires billing credit.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- xAI (Grok) ---------------------------------------------------------------
# Key from https://console.x.ai/
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# --- Anthropic Claude ---------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-5

# --- Bring-your-own-key from the browser --------------------------------------
# The web UI lets a visitor pick a provider and paste their own key, which is
# sent per request and stored only in their browser. That is what lets a
# deployed instance switch provider without a redeploy.
# Set to 0 to refuse client-supplied keys and use only the server's own.
# VERA_ALLOW_CLIENT_KEYS=1

# =============================================================================
# Cost guardrails
# =============================================================================
# Current Gemini models reason before answering. Thinking tokens are billed AND
# count against maxOutputTokens, so an uncapped request can spend a large budget
# and still return an empty answer. These caps are the defence; the defaults
# leave headroom for reasoning rather than trimming to the answer length.
# VERA_SYNTH_MAX_TOKENS=2048     # cap for the synthesis call
# VERA_VERIFY_MAX_TOKENS=1024    # cap for the verifier call
# VERA_THINKING_LEVEL=low        # low | high — protocol Q&A is extraction, not puzzles
# VERA_MAX_PASSAGE_CHARS=4000    # hard cap on any single passage sent to the model
# VERA_MAX_RETRIES=2             # transient (429/5xx) failures only; never auth errors
# VERA_REQUEST_TIMEOUT=60        # seconds
# VERA_CACHE_SIZE=256            # memoised answers per process; 0 disables caching

# =============================================================================
# Retrieval tuning
# =============================================================================
# VERA_TOP_K=3
# VERA_LOW_CONFIDENCE=0.34       # coverage below this -> abstain
# VERA_RELATIVE_FLOOR=0.2
# VERA_HEADING_BOOST=3.0

# Optional embeddings for hybrid retrieval (Voyage AI). Keyword-only without it.
# VOYAGE_API_KEY=

# =============================================================================
# Escalation
# =============================================================================
# Set VERA_ADO_MCP=1 to route escalations through the Azure DevOps MCP server
# instead of writing them to var/escalations/ as JSON.
# VERA_ADO_MCP=1
# ADO_PROJECT=YourAdoProject

# =============================================================================
# Paths and server
# =============================================================================
# VERA_PROTOCOLS_DIR=data/protocols
# VERA_MANIFEST_PATH=data/manifest.json
# VERA_ESCALATION_DIR=var/escalations
# HOST=127.0.0.1
# PORT=5000
# VERA_DEBUG=0
